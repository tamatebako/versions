---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// The served (directory) form — canonical must match what Pages actually
// serves, or every canonical names its own 301.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(path, Astro.site).href;
const fallbackDescription = 'Catalog of tebako runtime, payload and toolchain releases.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" type="application/rss+xml" title="tebako versions" href="/versions/versions.xml" />
    <meta name="description" content={description ?? fallbackDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="tebako versions" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? fallbackDescription} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/versions/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="tv-grain">
    <slot />
  </body>
</html>
