---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    {!noindex && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <link rel="alternate" type="application/rss+xml" title="tebako versions" href="/versions/versions.xml" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/versions/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="tv-grain">
    <slot />
  </body>
</html>
