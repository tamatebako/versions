---
import type { RuntimeRow } from '../lib/types';
import { deriveCapabilityChips, CAPABILITY_RULE_OWNERS } from '../lib/capabilities';
import { BOOTSTRAP_MAX_BYTES } from '../lib/gates';
import { lineViews, payloadViews, payloadKindGroups, latestLinePerEngine } from '../lib/groups';
import { linePath, payloadPath } from '../lib/paths';
import { mib, relAge, envName, badge } from '../lib/format';
import { loadVersions } from '../lib/data';
import PinSnippet from '../components/PinSnippet.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import BasePage from '../layouts/BasePage.astro';

const v = loadVersions();
const generated = new Date(v.generated_at);
const relAgeFrom = (iso: string): string => relAge(iso, generated);

// The directory consumes the catalog model owned by groups.ts: latest rows
// per line plus the pointer to the line's detail page.
interface LineGroup {
  engine: string;
  lang: string;
  flavor: string | null;
  latestTebako: string;
  releaseUrl: string;
  reference: string;
  rows: RuntimeRow[];
  olderCount: number;
}

const lineGroups: LineGroup[] = lineViews(v).map((lv) => ({
  engine: lv.engine,
  lang: lv.lang,
  flavor: lv.flavor,
  latestTebako: lv.latestTebako,
  releaseUrl: lv.groups[0].release.url,
  reference: lv.groups[0].rows[0].reference,
  rows: lv.groups[0].rows,
  olderCount: lv.releaseCount - 1,
}));

const payloads = payloadViews(v);
const payloadKindGroupsList = payloadKindGroups(payloads);

const buildStamp = `${v.generated_at.slice(0, 10)} ${v.generated_at.slice(11, 16)} UTC`;
const okSources = v.sources.filter((s) => s.ok);

// The hero's thesis is the ledger itself: scale + freshness, from the data.
const engineLineCounts = lineViews(v).reduce((acc, lv) => {
  acc[lv.engine] = (acc[lv.engine] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);
const newestPublish = v.runtimes
  .map((r) => r.release.published_at)
  .concat(v.toolchain.map((t) => t.published_at))
  .sort()
  .at(-1);

// Static shields.io badge snippets (plan 05): generated from the data at
// build time, copied as markdown — no dynamic badge service.
const latestLineBadges = latestLinePerEngine(v).map((best) =>
  badge('tebako runtime', `${best.engine} ${best.lang_version}${best.flavor ? `-${best.flavor}` : ''} · ${best.tebako_line}`),
);
const payloadBadge = payloads[0]
  ? badge('tebako payload', `${payloads[0].name} ${payloads[0].latestVersion}`)
  : null;
const toolchainBadge = v.toolchain[0] ? badge('tebako toolchain', v.toolchain[0].version) : null;
---

<BasePage
  title="tebako versions"
  description="Catalog of tebako runtime, payload and toolchain releases — a static, read-only rendering of the published registries and factory releases."
>
    <main class="page">
      <header class="hero">
        <p class="eyebrow">catalog</p>
        <h1>tebako versions</h1>
        <p class="lede">Every published runtime, payload and toolchain release — find your line, copy its pin.</p>
        <p class="ledger">
          {Object.entries(engineLineCounts).map(([engine, n]) => <span>{n} {engine} lines</span>)}
          <span>{payloads.length} payloads</span>
          <span>{v.toolchain.length} tebako releases</span>
          {newestPublish && <span>newest {relAgeFrom(newestPublish)}</span>}
        </p>
        <p class="stamp">
          Built {buildStamp} · <a href="https://www.tebako.org/">tebako.org</a>
        </p>
        <label class="filter">
          <span class="filter-label">filter</span>
          <input id="filter" type="search" placeholder="ruby, 3.3.12, macos-arm64, metanorma…" autocomplete="off" />
        </label>
        <p class="no-match" id="no-match" hidden>
          No drawer matches <em id="no-match-q"></em> — <button type="button" id="no-match-clear">clear the filter</button>
        </p>
        <noscript><style>.filter { display: none; }</style></noscript>
      </header>

      <section id="runtimes" class="section" data-section>
        <p class="eyebrow">interpreter + env image pairs</p>
        <h2>Runtimes</h2>
        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th scope="col">platform</th>
                <th scope="col">capabilities</th>
                <th scope="col">exe / image MiB</th>
                <th scope="col">downloads</th>
                <th scope="col">age</th>
                <th scope="col">sha256</th>
              </tr>
            </thead>
            {
              lineGroups.map((g) => (
                <tbody
                  class="line"
                  data-filter={[g.engine, g.lang, g.flavor ?? '', g.latestTebako, ...g.rows.map((r) => r.triplet)].join(' ')}
                >
                  <tr class="line-head">
                    <th colspan="6" scope="rowgroup">
                      <div class="line-id">
                        <span class="line-engine">{g.engine}</span>
                        <span class="line-version">{g.lang}</span>
                        {g.flavor && <span class="chip chip-flavor" title={`flavor: ${g.flavor}`}>{g.flavor}</span>}
                        <a class="line-release" href={g.rows[0]?.release.url}>
                          {g.latestTebako}
                        </a>
                      </div>
                      {g.rows[0] && (
                        <PinSnippet
                          snippets={[
                            { hint: 'reference', code: g.rows[0].reference },
                            {
                              hint: 'config.yaml',
                              code: `runtimes:\n  ${g.engine}: { version: ${g.lang}, tebako: ${g.latestTebako} }`,
                            },
                          ]}
                        />
                      )}
                      <a
                        class="line-all"
                        href={linePath(g.engine, g.lang, g.flavor)}
                      >
                        all releases ({g.olderCount + 1}) ↗
                      </a>
                    </th>
                  </tr>
                  {g.rows.map((r) => {
                    const chips = deriveCapabilityChips(r);
                    return (
                      <tr>
                        <td>
                          <span class="chip chip-platform">{r.triplet}</span>
                          {r.release.prerelease && <span class="chip chip-pre" title="prerelease">pre</span>}
                        </td>
                        <td>
                          {r.capabilities !== null ? (
                            r.capabilities.map((c) => (
                              <span class="chip chip-cap chip-flowed" title="flowed from the factory's published runtime manifest">
                                {c}
                              </span>
                            ))
                          ) : (
                            chips.map((c) => (
                              <a class="chip chip-cap" href="#cap-rules" title={c.note}>
                                {c.label}
                              </a>
                            ))
                          )}
                        </td>
                        <td class="mono num">
                          {r.exe ? mib(r.exe.size) : '—'} / {r.image ? mib(r.image.size) : '—'}
                        </td>
                        <td class="num">{r.exe ? r.exe.downloads : '—'}</td>
                        <td class="num">{relAgeFrom(r.release.published_at)}</td>
                        <td class="mono sha" title={r.exe?.sha256 ?? 'no checksum fetched for older releases'}>
                          {r.exe?.sha256 ? r.exe.sha256.slice(0, 12) : '—'}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              ))
            }
          </table>
        </div>
        <p class="cap-rules" id="cap-rules">
          <strong>Solid chips</strong> flow from the factories' published runtime manifests
          (<code>capabilities:</code> key — the authority). <strong>Dotted chips</strong> are derived at render
          time for pre-key releases (and fetch misses) — a marked fallback, never the authority. Rules: ruby
          <code>yjit</code> — non-windows, ruby ≥ 3.2 or the 3.1 line on x86_64; owner:
          <a href={CAPABILITY_RULE_OWNERS.ruby_yjit}>tebako-runtime-ruby capabilities.rb</a>. python
          <code>jit</code> — the asset name carries the <code>-jit</code> flavor; owner:
          <a href={CAPABILITY_RULE_OWNERS.python_jit}>tebako-runtime-python releases</a>.
        </p>
        {latestLineBadges.length > 0 && (
          <div class="badge-row">
            <PinSnippet snippets={latestLineBadges.map((code) => ({ hint: 'badge markdown', code }))} />
          </div>
        )}
      </section>

      <section id="payloads" class="section" data-section>
        <p class="eyebrow">apps + toolkits from the feedstocks</p>
        <h2>Payloads</h2>
        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th scope="col">name</th>
                <th scope="col">latest</th>
                <th scope="col">versions</th>
                <th scope="col">entrypoints</th>
                <th scope="col">runtime</th>
                <th scope="col">platforms</th>
                <th scope="col">registry</th>
                <th scope="col">pin</th>
              </tr>
            </thead>
            {
              payloadKindGroupsList.map((kg) => (
                <tbody
                  class="kind"
                  data-filter={kg.rows.map((p) => `${p.name} ${p.kind ?? ''} ${p.latestVersion}`).join(' ')}
                >
                  <tr class="kind-head">
                    <th colspan="8" scope="rowgroup">
                      {kg.kind}s ({kg.rows.length})
                    </th>
                  </tr>
                  {kg.rows.map((p) => (
                    <tr
                      class="payload-row"
                      data-filter={[p.name, p.kind ?? '', p.latestVersion, p.runtimeRequirement ?? '', ...p.entrypoints].join(' ')}
                    >
                      <td class="name">
                        <a href={payloadPath(p.name)}>{p.name}</a>
                        {p.summary && <span class="name-summary">{p.summary}</span>}
                      </td>
                    <td class="mono">{p.latestVersion}</td>
                    <td class="num">{p.versionCount}</td>
                    <td class="num" title={p.entrypoints.join(', ') || '—'}>
                      {p.entrypoints.length} {p.entrypoints.length > 0 && <span class="entry-first">· {p.entrypoints[0]}</span>}
                    </td>
                    <td class="mono">{p.runtimeRequirement ?? '—'}</td>
                    <td class="num">
                      {p.platformCount}
                    </td>
                    <td>
                      <a href={p.registryUrl}>{p.registryRepo}</a>
                    </td>
                    <td class="pin-cell">
                      {p.entrypoints[0] && (
                        <PinSnippet
                          snippets={[
                            { hint: 'env pin', code: `${envName(p.entrypoints[0])}=${p.latestVersion}` },
                            { hint: 'shim verb', code: `tebako-shim use ${p.entrypoints[0]} ${p.latestVersion}` },
                          ]}
                        />
                      )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              ))
            }
          </table>
        </div>
        {payloadBadge && (
          <div class="badge-row">
            <PinSnippet snippets={[{ hint: 'badge markdown', code: payloadBadge }]} />
          </div>
        )}
      </section>

      <section id="toolchain" class="section" data-section>
        <p class="eyebrow">the packager itself</p>
        <h2>Toolchain</h2>
        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th scope="col">version</th>
                <th scope="col">age</th>
                <th scope="col">bootstrap size per platform — {`< ${mib(BOOTSTRAP_MAX_BYTES)} MiB gate`}</th>
                <th scope="col">release</th>
              </tr>
            </thead>
            <tbody>
              {
                v.toolchain.map((t) => (
                  <tr
                    class="toolchain-row"
                    data-filter={[t.version, ...t.bootstrap.map((b) => b.triplet)].join(' ')}
                  >
                    <td class="mono">{t.version}</td>
                    <td class="num">{relAgeFrom(t.published_at)}</td>
                    <td>
                      <span class="gate-chips">
                        {t.bootstrap.map((b) => (
                          <span
                            class={`chip chip-gate ${b.bytes < BOOTSTRAP_MAX_BYTES ? 'chip-ok' : 'chip-bad'}`}
                            title={`${b.triplet}: ${b.bytes.toLocaleString('en-US')} bytes (gate ${BOOTSTRAP_MAX_BYTES.toLocaleString('en-US')})`}
                          >
                            {b.triplet.replace('linux-gnu-', 'gnu-').replace('linux-musl-', 'musl-')}{' '}
                            {mib(b.bytes)}
                          </span>
                        ))}
                      </span>
                    </td>
                    <td>
                      <a href={t.url}>{t.url.replace('https://github.com', '')}</a>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        {toolchainBadge && (
          <div class="badge-row">
            <PinSnippet snippets={[{ hint: 'badge markdown', code: toolchainBadge }]} />
          </div>
        )}
      </section>

      <footer class="footer">
        <p class="eyebrow">rendered from</p>
        <ul class="sources">
          {
            okSources.map((s) => (
              <li>
                <span class="src-kind">{s.kind}</span>
                <a href={s.url}>{s.url.replace(/^https:\/\/(api\.github\.com|raw\.githubusercontent\.com)\//, '')}</a>
                {s.note && <span class="src-note"> — {s.note}</span>}
              </li>
            ))
          }
        </ul>
        <p class="readonly">
          This page is a read-only rendering. Canonical resolution lives in the published registries and factory
          releases (tebako spec 00, invariant 10).
        </p>
        <p class="stamp">Built {buildStamp} · <a href="https://www.tebako.org/">tebako.org</a></p>
      </footer>
    </main>

    <script>
      const input = document.getElementById('filter') as HTMLInputElement | null;
      const noMatch = document.getElementById('no-match');
      const noMatchQ = document.getElementById('no-match-q');
      const noMatchClear = document.getElementById('no-match-clear');
      const apply = () => {
        if (!input) return;
        const q = input.value.trim().toLowerCase();
        for (const el of document.querySelectorAll<HTMLElement>('[data-filter]')) {
          el.toggleAttribute('hidden', q.length > 0 && !el.getAttribute('data-filter')!.toLowerCase().includes(q));
        }
        let anySection = false;
        for (const section of document.querySelectorAll<HTMLElement>('[data-section]')) {
          const targets = section.querySelectorAll<HTMLElement>('[data-filter]');
          const anyVisible = [...targets].some((t) => !t.hasAttribute('hidden'));
          anySection = anySection || anyVisible;
          section.toggleAttribute('hidden', q.length > 0 && !anyVisible);
        }
        if (noMatch) {
          noMatch.toggleAttribute('hidden', !(q.length > 0 && !anySection));
          if (noMatchQ) noMatchQ.textContent = `“${input.value.trim()}”`;
        }
      };
      input?.addEventListener('input', apply);
      noMatchClear?.addEventListener('click', () => {
        if (input) {
          input.value = '';
          apply();
          input.focus();
        }
      });
    </script>
</BasePage>

<style is:global>
  /* index-specific: the directory layout, filter, line/kind rows, footer.
     Shared scaffold/table/chip language lives in styles/base.css. */
  :root {
    --tv-page-width: 78rem;
    --tv-table-min: 54rem;
  }

  .hero {
    margin-bottom: 2.5rem;
  }

  h1 {
    margin: 0;
    font-family: var(--tv-font-display);
    font-weight: 600;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--tv-text-1);
  }

  .lede {
    font-size: 1.0625rem;
  }

  .section {
    margin-top: 3rem;
  }
  .section h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .ledger {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 0.9rem 0 0;
    font-family: var(--tv-font-mono);
    font-size: 0.8125rem;
    color: var(--tv-text-2);
  }
  .badge-row {
    margin-top: 0.7rem;
  }
  .cap-rules {
    margin: 0.8rem 0 0;
    max-width: 52rem;
    font-size: 0.8125rem;
    color: var(--tv-text-3);
  }
  .cap-rules code {
    font-size: 0.75rem;
  }

  .line-head th {
    background: var(--tv-bg-warm);
    border-bottom: 1px solid var(--tv-divider-strong);
    padding: 0.7rem 0.9rem;
  }

  .line-id {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .line-engine {
    font-family: var(--tv-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tv-accent);
  }
  .line-version {
    font-family: var(--tv-font-display);
    font-weight: 600;
    font-size: 1.125rem;
    color: var(--tv-text-1);
  }
  .line-release {
    font-family: var(--tv-font-mono);
    font-size: 0.75rem;
    color: var(--tv-text-2);
  }
  a.line-all {
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--tv-text-2);
  }
  a.line-all:hover {
    color: var(--tv-accent-text);
  }

  .gate-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .kind-head th {
    background: var(--tv-bg-warm);
    border-bottom: 1px solid var(--tv-divider-strong);
    padding: 0.6rem 0.9rem;
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tv-accent);
  }
  .name-summary {
    display: block;
    font-size: 0.75rem;
    font-family: var(--tv-font-sans);
    font-weight: 400;
    color: var(--tv-text-3);
    white-space: normal;
    max-width: 26rem;
  }
  .payload-row .name {
    font-weight: 600;
    color: var(--tv-text-1);
    white-space: nowrap;
  }
  .entry-first {
    color: var(--tv-text-3);
    font-size: 0.75rem;
    font-family: var(--tv-font-mono);
  }
  .pin-cell {
    min-width: 22rem;
  }

  .footer {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--tv-divider-strong);
  }
  .sources {
    margin: 0.5rem 0 1.25rem;
    padding: 0;
    list-style: none;
    columns: 2;
    column-gap: 2rem;
  }
  .sources li {
    font-size: 0.8125rem;
    color: var(--tv-text-2);
    break-inside: avoid;
    margin-bottom: 0.3rem;
  }
  .src-kind {
    display: inline-block;
    font-family: var(--tv-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tv-text-3);
    margin-right: 0.45rem;
  }
  .src-note {
    color: var(--tv-text-3);
  }
  .readonly {
    max-width: 44rem;
    font-size: 0.9375rem;
    color: var(--tv-text-2);
  }

  @media (max-width: 48rem) {
    .sources {
      columns: 1;
    }
  }
</style>
