---
import { loadVersions } from '../../lib/data';
import { envName, badge } from '../../lib/format';
import PinSnippet from '../../components/PinSnippet.astro';
import '../../styles/tokens.css';
import '../../styles/base.css';

export async function getStaticPaths() {
  return (await import('../../lib/paths')).payloadRoutes();
}

const { payload, versions } = Astro.props;

const payloadBadge = badge('tebako payload', `${payload.name} ${versions[0]?.version ?? ''}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index,follow" />
    <title>{payload.name} — tebako versions</title>
    <link rel="icon" type="image/svg+xml" href="/versions/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body class="tv-grain">
    <main class="page">
      <header class="hero">
        <p class="eyebrow"><a href="/versions/">← catalog</a></p>
        <h1>
          {payload.name}
          {payload.kind && <span class="chip chip-flavor">{payload.kind}</span>}
        </h1>
        {payload.summary && <p class="lede">{payload.summary}</p>}
        <p class="stamp">
          {versions.length} version{versions.length === 1 ? '' : 's'} · registry:
          <a href={payload.registry_url}>{payload.registry_repo}</a> ·
          <a href="https://www.tebako.org/">tebako.org</a>
        </p>
        <div class="hero-pins">
          <PinSnippet snippets={[{ hint: 'badge markdown', code: payloadBadge }]} />
        </div>
      </header>

      {
        versions.map((ver, i) => (
          <section class:list={['section', { current: i === 0, older: i > 0 }]}>
            <div class="group-head">
              <h2>{ver.version}</h2>
              {i === 0 && <span class="chip chip-flowed">latest</span>}
              <span class="group-meta mono">{ver.runtime_requirement ?? 'runtime: —'}</span>
            </div>

            {ver.entrypoints.length > 0 && (
              <div class="block">
                <p class="block-label">entrypoints — pin any</p>
                <PinSnippet
                  snippets={[
                    ...ver.entrypoints.map((tool) => ({
                      hint: `env ${tool}`,
                      code: `${envName(tool)}=${ver.version}`,
                    })),
                    ...(ver.entrypoints[0]
                      ? [{ hint: 'shim verb', code: `tebako-shim use ${ver.entrypoints[0]} ${ver.version}` }]
                      : []),
                  ]}
                />
              </div>
            )}

            {ver.platforms.length > 0 && (
              <div class="tablewrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">platform</th>
                      <th scope="col">artifact</th>
                      <th scope="col">sha256</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ver.platforms.map((pf) => (
                      <tr>
                        <td>
                          <span class="chip chip-platform">{pf.platform}</span>
                        </td>
                        <td class="mono artifact">{pf.artifact ?? '—'}</td>
                        <td>
                          {pf.sha256 ? (
                            <PinSnippet snippets={[{ hint: pf.platform, code: pf.sha256 }]} />
                          ) : (
                            <span class="mono sha">—</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))
      }
    </main>
  </body>
</html>

<style is:global>
  /* payload-page-specific; shared language in styles/base.css */
  h1 {
    margin: 0;
    font-family: var(--tv-font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--tv-text-1);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .section.older {
    opacity: 0.88;
  }

  .hero-pins {
    margin-top: 1rem;
  }

  .block {
    margin-bottom: 0.9rem;
  }
  .block-label {
    margin: 0 0 0.3rem;
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tv-text-3);
  }

  .artifact {
    white-space: nowrap;
    color: var(--tv-text-2);
  }
</style>
