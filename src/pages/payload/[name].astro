---
import { loadVersions } from '../../lib/data';
import { envName, badge } from '../../lib/format';
import { payloadPath, linePath, runtimeRequirementTarget } from '../../lib/paths';
import PinSnippet from '../../components/PinSnippet.astro';
import '../../styles/tokens.css';
import '../../styles/base.css';
import BasePage from '../../layouts/BasePage.astro';

export async function getStaticPaths() {
  return (await import('../../lib/paths')).payloadRoutes();
}

const { payload, versions } = Astro.props;

const payloadBadge = badge('tebako payload', `${payload.name} ${versions[0]?.version ?? ''}`);
const allPayloads = loadVersions().payloads;
const reqTarget = (req: string | null) => (req ? runtimeRequirementTarget(req, loadVersions()) : null);
const P_TITLE = `${payload.name} — tebako versions`;
const P_DESC = payload.summary ?? `Every version of the ${payload.name} payload — entrypoints, platforms, sha256s.`;
---

<BasePage title={P_TITLE} description={P_DESC}>
    <main class="page">
      <header class="hero">
        <p class="eyebrow"><a href="/versions/">← catalog</a></p>
        <h1>
          <span class="h1-engine">payload</span>
          <span class="h1-version">{payload.name}</span>
          {payload.kind && <span class="chip chip-flavor">{payload.kind}</span>}
        </h1>
        {payload.summary && <p class="lede">{payload.summary}</p>}
        <p class="stamp">
          {versions.length} version{versions.length === 1 ? '' : 's'} · registry:
          <a href={payload.registry_url}>{payload.registry_repo}</a> ·
          <a href="https://www.tebako.org/">tebako.org</a>
        </p>
        <div class="hero-pins">
          <PinSnippet snippets={[{ hint: 'badge markdown', code: payloadBadge }]} />
        </div>
      </header>

      {
        versions.map((ver, i) => (
          <section class:list={['section', { current: i === 0, older: i > 0 }]}>
            <div class="group-head">
              <h2>{ver.version}</h2>
              {i === 0 && <span class="chip chip-flowed">latest</span>}
              <span class="group-meta mono">
                {(() => {
                  const t = reqTarget(ver.runtime_requirement);
                  return t ? (
                    <a href={linePath(t.engine, t.lang, t.flavor)} title={`runtime line satisfying ${ver.runtime_requirement}`}>
                      {ver.runtime_requirement}
                    </a>
                  ) : (
                    ver.runtime_requirement ?? 'runtime: —'
                  );
                })()}
              </span>
            </div>

            {ver.entrypoints.length > 0 && (
              <div class="block">
                <p class="block-label">entrypoints — pin any</p>
                <PinSnippet
                  snippets={[
                    ...ver.entrypoints.map((tool) => ({
                      hint: `env ${tool}`,
                      code: `${envName(tool)}=${ver.version}`,
                    })),
                    ...(ver.entrypoints[0]
                      ? [{ hint: 'shim verb', code: `tebako-shim use ${ver.entrypoints[0]} ${ver.version}` }]
                      : []),
                  ]}
                />
              </div>
            )}

            {ver.platforms.length > 0 && (
              <div class="tablewrap">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">platform</th>
                      <th scope="col">artifact</th>
                      <th scope="col">sha256</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ver.platforms.map((pf) => (
                      <tr>
                        <td>
                          <span class="chip chip-platform">{pf.platform}</span>
                        </td>
                        <td class="mono artifact">{pf.artifact ?? '—'}</td>
                        <td>
                          {pf.sha256 ? (
                            <PinSnippet snippets={[{ hint: pf.platform, code: pf.sha256 }]} />
                          ) : (
                            <span class="mono sha">—</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </section>
        ))
      }
      <p class="footer-note">
        Other payloads: {' '}
        {allPayloads
          .filter((o) => o.name !== payload.name)
          .map((o) => <a href={payloadPath(o.name)}>{o.name}</a>)}
      </p>
    </main>
  </BasePage>

<style is:global>
  /* payload-page-specific; shared language in styles/base.css */
  h1 {
    margin: 0;
    line-height: 1.1;
    color: var(--tv-text-1);
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .h1-engine {
    font-family: var(--tv-font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tv-accent-text);
  }
  .h1-version {
    font-family: var(--tv-font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.02em;
  }

  .section.older {
    opacity: 0.88;
  }

  .hero-pins {
    margin-top: 1rem;
  }

  .block {
    margin-bottom: 0.9rem;
  }
  /* The entrypoints field can carry ~40 pins (metanorma): let them wrap as a
     chip field instead of stacking into a wall */
  .block .pins {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    align-items: center;
  }
  .block-label {
    margin: 0 0 0.3rem;
    font-family: var(--tv-font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tv-text-3);
  }

  .footer-note {
    margin-top: 3rem;
    font-family: var(--tv-font-mono);
    font-size: 0.8125rem;
    color: var(--tv-text-3);
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .artifact {
    white-space: nowrap;
    color: var(--tv-text-2);
  }
</style>
