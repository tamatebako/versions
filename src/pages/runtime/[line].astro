---
import { deriveCapabilityChips } from '../../lib/capabilities';
import { lineViews } from '../../lib/groups';
import { linePath } from '../../lib/paths';
import { loadVersions } from '../../lib/data';
import { mib, relAge } from '../../lib/format';
import PinSnippet from '../../components/PinSnippet.astro';
import '../../styles/tokens.css';
import '../../styles/base.css';
import BasePage from '../../layouts/BasePage.astro';

export async function getStaticPaths() {
  return (await import('../../lib/paths')).runtimeRoutes();
}

const { view } = Astro.props;
const v = loadVersions();
const views = lineViews(v);
const relAgeFrom = (iso: string): string => relAge(iso, new Date(v.generated_at));
const R_TITLE = `${view.engine} ${view.lang}${view.flavor ? `-${view.flavor}` : ''} — tebako versions`;
const R_DESC = `Every release of the ${view.engine} ${view.lang}${view.flavor ? `-${view.flavor}` : ''} runtime line — pins, sizes, sha256s per platform.`;
---

<BasePage title={R_TITLE} description={R_DESC}>
    <main class="page">
      <header class="hero">
        <p class="eyebrow"><a href="/versions/">← catalog</a></p>
        <h1>
          <span class="h1-engine">{view.engine}</span>
          <span class="h1-version">{view.lang}</span>
          {view.flavor && <span class="chip chip-flavor">{view.flavor}</span>}
        </h1>
        <p class="lede">
          {view.releaseCount} release{view.releaseCount === 1 ? '' : 's'} · {view.tripletCount} platforms · current
          tebako line <a href={view.groups[0].release.url}>{view.latestTebako}</a>
        </p>
        <p class="stamp">Built {v.generated_at.slice(0, 10)} {v.generated_at.slice(11, 16)} UTC · <a href="https://www.tebako.org/">tebako.org</a></p>
        <label class="filter">
          <span class="filter-label">filter</span>
          <input id="filter" type="search" placeholder="musl, 0.16.21, yjit…" autocomplete="off" />
        </label>
        <p class="no-match" id="no-match" hidden>
          No drawer matches <em id="no-match-q"></em> — <button type="button" id="no-match-clear">clear the filter</button>
        </p>
        <noscript><style>.filter { display: none; }</style></noscript>
      </header>

      {
        view.groups.map((g) => (
          <section class:list={['section', { current: g.isLatest, older: !g.isLatest }]} data-section>
            <div class="group-head">
              <h2>
                tebako <a href={g.release.url}>{g.tebakoLine}</a>
              </h2>
              <span class="group-meta">
                {relAgeFrom(g.release.published_at)}
                {g.release.prerelease && <span class="chip chip-pre" title="prerelease">pre</span>}
                {g.isLatest && <span class="chip chip-flowed">current</span>}
              </span>
              <PinSnippet
                snippets={[
                  { hint: 'reference', code: g.rows[0].reference },
                  {
                    hint: 'config.yaml',
                    code: `runtimes:\n  ${view.engine}: { version: ${view.lang}, tebako: ${g.tebakoLine} }`,
                  },
                ]}
              />
            </div>
            <div class="tablewrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">platform</th>
                    <th scope="col">capabilities</th>
                    <th scope="col">exe / image MiB</th>
                    <th scope="col">downloads</th>
                    <th scope="col">sha256 (exe)</th>
                  </tr>
                </thead>
                <tbody>
                  {g.rows.map((r) => {
                    const chips = deriveCapabilityChips(r);
                    return (
                      <tr
                        data-filter={[r.triplet, g.tebakoLine, ...(r.capabilities ?? chips.map((c) => c.label))].join(' ')}
                      >
                        <td>
                          <span class="chip chip-platform">{r.triplet}</span>
                        </td>
                        <td>
                          {r.capabilities !== null
                            ? r.capabilities.map((c) => (
                                <span class="chip chip-cap chip-flowed" title="flowed from the factory's published runtime manifest">
                                  {c}
                                </span>
                              ))
                            : chips.map((c) => (
                                <a class="chip chip-cap" href="/versions/#cap-rules" title={c.note}>
                                  {c.label}
                                </a>
                              ))}
                        </td>
                        <td class="mono num">
                          {r.exe ? mib(r.exe.size) : '—'} / {r.image ? mib(r.image.size) : '—'}
                        </td>
                        <td class="num">{r.exe ? r.exe.downloads : '—'}</td>
                        <td class="mono sha" title={r.exe?.sha256 ?? 'no checksum fetched for older releases'}>
                          {r.exe?.sha256 ? r.exe.sha256.slice(0, 12) : '—'}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        ))
      }

      <p class="footer-note">
        Other lines: {' '}
        {views
          .filter((o) => o.engine === view.engine && o.slug !== view.slug)
          .map((o) => (
            <a href={linePath(o.engine, o.lang, o.flavor)}>
              {o.lang}
              {o.flavor ? `-${o.flavor}` : ''}
            </a>
          ))
          .concat(views.filter((o) => o.engine !== view.engine).map((o) => <a href={linePath(o.engine, o.lang, o.flavor)}>{o.engine}</a>))}
      </p>
    </main>
  </BasePage>

<style is:global>
  /* line-page-specific; shared language in styles/base.css */
  h1 {
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--tv-text-1);
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .h1-engine {
    font-family: var(--tv-font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tv-accent-text);
  }
  .h1-version {
    font-family: var(--tv-font-display);
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.02em;
  }

  .section.older {
    opacity: 0.88;
  }

  :root {
    --tv-table-min: 40rem;
  }

  .footer-note {
    margin-top: 3rem;
    font-family: var(--tv-font-mono);
    font-size: 0.8125rem;
    color: var(--tv-text-3);
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
</style>

<script>
  const input = document.getElementById('filter') as HTMLInputElement | null;
  const noMatch = document.getElementById('no-match');
  const noMatchQ = document.getElementById('no-match-q');
  const noMatchClear = document.getElementById('no-match-clear');
  const apply = () => {
    if (!input) return;
    const q = input.value.trim().toLowerCase();
    for (const el of document.querySelectorAll<HTMLElement>('[data-filter]')) {
      el.toggleAttribute('hidden', q.length > 0 && !el.getAttribute('data-filter')!.toLowerCase().includes(q));
    }
    let anySection = false;
    for (const section of document.querySelectorAll<HTMLElement>('[data-section]')) {
      const any = [...section.querySelectorAll<HTMLElement>('[data-filter]')].some((t) => !t.hasAttribute('hidden'));
      anySection = anySection || any;
      section.toggleAttribute('hidden', q.length > 0 && !any);
    }
    if (noMatch) {
      noMatch.toggleAttribute('hidden', !(q.length > 0 && !anySection));
      if (noMatchQ) noMatchQ.textContent = `“${input.value.trim()}”`;
    }
  };
  input?.addEventListener('input', apply);
  noMatchClear?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      apply();
      input.focus();
    }
  });
</script>
