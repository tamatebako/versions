---
import BasePage from '../layouts/BasePage.astro';
import '../styles/tokens.css';
import '../styles/base.css';
---

<BasePage title="not in the box — tebako versions" noindex>
  <main class="missing">
    <p class="eyebrow">empty drawer</p>
    <h1>Not in the box</h1>
    <p class="lede">This page doesn't exist. The catalog is one drawer up.</p>
    <p class="links">
      <a href="/versions/">tebako versions</a> · <a href="https://www.tebako.org/">tebako.org</a>
    </p>
  </main>
</BasePage>

<style is:global>
  .missing {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    margin: 0 auto;
    padding: 6rem 1.25rem;
    text-align: center;
  }
  .links {
    margin-top: 1.5rem;
    font-family: var(--tv-font-mono);
    font-size: 0.875rem;
  }
</style>
